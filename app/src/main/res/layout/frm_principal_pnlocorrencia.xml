<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#F5F5F5">

    <!-- Cabeçalho -->

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="#FFFFFF"
            android:gravity="center_vertical"
            android:elevation="3dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

        <TextView
                android:id="@+id/tvTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NOVO PROBLEMA"
                android:textColor="#4B0082"
                android:textStyle="bold"
                android:textSize="22sp"/>

    </LinearLayout>

    <!-- Scroll -->

    <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

            <!-- Card -->

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#FFFFFF"
                    android:elevation="3dp"
                    android:padding="16dp">

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Título"
                        android:textStyle="bold"
                        android:textColor="#444444"/>

                <EditText
                        android:id="@+id/edtTitulo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Ex.: Buraco na avenida"/>

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="Descrição"
                        android:textStyle="bold"
                        android:textColor="#444444"/>

                <EditText
                        android:id="@+id/edtDescricao"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:gravity="top"
                        android:hint="Descreva o problema..."
                        android:inputType="textMultiLine"/>

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="Categoria"
                        android:textStyle="bold"
                        android:textColor="#444444"/>

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical">

                    <!-- Primeira linha -->

                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                        <LinearLayout
                                android:id="@+id/cardBuraco"
                                android:layout_width="0dp"
                                android:layout_height="90dp"
                                android:layout_weight="1"
                                android:layout_margin="4dp"
                                android:background="@drawable/bg_categoria"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:clickable="true"
                                android:focusable="true">

                            <ImageView
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:src="@drawable/ic_buraco"/>

                            <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:text="Buraco"
                                    android:textStyle="bold"/>
                        </LinearLayout>

                        <LinearLayout
                                android:id="@+id/cardIluminacao"
                                android:layout_width="0dp"
                                android:layout_height="90dp"
                                android:layout_weight="1"
                                android:layout_margin="4dp"
                                android:background="@drawable/bg_categoria"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:clickable="true"
                                android:focusable="true">

                            <ImageView
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:src="@drawable/ic_iluminacao"/>

                            <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:text="Iluminação"
                                    android:textStyle="bold"/>
                        </LinearLayout>

                    </LinearLayout>

                    <!-- Segunda linha -->

                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                        <LinearLayout
                                android:id="@+id/cardLixo"
                                android:layout_width="0dp"
                                android:layout_height="90dp"
                                android:layout_weight="1"
                                android:layout_margin="4dp"
                                android:background="@drawable/bg_categoria"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:clickable="true"
                                android:focusable="true">

                            <ImageView
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:src="@drawable/ic_lixo"/>

                            <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:text="Lixo"
                                    android:textStyle="bold"/>
                        </LinearLayout>

                        <LinearLayout
                                android:id="@+id/cardArvore"
                                android:layout_width="0dp"
                                android:layout_height="90dp"
                                android:layout_weight="1"
                                android:layout_margin="4dp"
                                android:background="@drawable/bg_categoria"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:clickable="true"
                                android:focusable="true">

                            <ImageView
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:src="@drawable/ic_arvore"/>

                            <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:text="Árvore"
                                    android:textStyle="bold"/>
                        </LinearLayout>

                    </LinearLayout>

                    <!-- Terceira linha -->

                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                        <LinearLayout
                                android:id="@+id/cardObra"
                                android:layout_width="0dp"
                                android:layout_height="90dp"
                                android:layout_weight="1"
                                android:layout_margin="4dp"
                                android:background="@drawable/bg_categoria"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:clickable="true"
                                android:focusable="true">

                            <ImageView
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:src="@drawable/ic_obra"/>

                            <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:text="Obra"
                                    android:textStyle="bold"/>
                        </LinearLayout>

                        <LinearLayout
                                android:id="@+id/cardOutros"
                                android:layout_width="0dp"
                                android:layout_height="90dp"
                                android:layout_weight="1"
                                android:layout_margin="4dp"
                                android:background="@drawable/bg_categoria"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:clickable="true"
                                android:focusable="true">

                            <ImageView
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:src="@drawable/ic_outros"/>

                            <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:text="Outros"
                                    android:textStyle="bold"/>
                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="Imagem"
                        android:textStyle="bold"
                        android:textColor="#444444"/>

                <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:scrollbars="none">

                    <LinearLayout
                            android:id="@+id/llFotosPreview"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"/>

                </HorizontalScrollView>

                <Button
                        android:id="@+id/btnAdicionarImagem"
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_botao_roxo"
                        android:text="Adicionar Foto"
                        android:textColor="#FFFFFF"/>

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="Localização"
                        android:textStyle="bold"
                        android:textColor="#444444"/>

                <LinearLayout
                        android:id="@+id/layoutLocalizacao"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="#F8F8F8"
                        android:orientation="vertical"
                        android:padding="12dp">

                    <TextView
                            android:id="@+id/txtEndereco"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Obtendo localização..."
                            android:textStyle="bold"
                            android:textColor="#333333"/>

                    <TextView
                            android:id="@+id/txtCidade"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text=""
                            android:textColor="#777777"/>

                    <Button
                            android:id="@+id/btnAlterarLocalizacao"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_botao_roxo"
                            android:text="Alterar localização"
                            android:textColor="#FFFFFF"
                            android:visibility="gone"/>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Barra inferior fixa -->

    <LinearLayout
            android:id="@+id/layoutBotoes"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:background="#FFFFFF"
            android:elevation="8dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="12dp">

        <Button
                android:id="@+id/btnCancelar"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="#E0E0E0"
                android:text="Cancelar"
                android:textColor="#444444"/>

        <Button
                android:id="@+id/btnReportar"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_botao_roxo"
                android:text="Reportar"
                android:textColor="#FFFFFF"
                android:textStyle="bold"/>

    </LinearLayout>

</LinearLayout>