<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#FFE14D">

    <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

            <!-- Título -->
            <TextView
                    android:id="@+id/tvTitulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="MEU PERFIL"
                    android:textColor="#4B0082"
                    android:textSize="24sp"
                    android:textStyle="bold" />

            <!-- Foto e Nome -->
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="16dp"
                    android:background="#FFFFFF"
                    android:elevation="4dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp">

                <ImageView
                        android:id="@+id/imgPerfil"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:background="@drawable/bg_circulo_amarelo"
                        android:scaleType="centerCrop" />

                <TextView
                        android:id="@+id/tvNome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Henrique Laste Cansi"
                        android:textColor="#000000"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                <TextView
                        android:id="@+id/tvCidade"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Caxias do Sul"
                        android:textColor="#888888"
                        android:textSize="14sp" />

            </LinearLayout>

            <!-- Pontos / Prêmios -->
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginBottom="20dp"
                    android:background="#4B0082"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:padding="8dp">

                <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                    <TextView
                            android:id="@+id/tvPontos"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="190"
                            android:textColor="#FFE14D"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pontos"
                            android:textColor="#FFFFFF" />

                </LinearLayout>

                <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                    <TextView
                            android:id="@+id/tvPremios"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="02"
                            android:textColor="#FFE14D"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ocorrências"
                            android:textColor="#FFFFFF" />

                </LinearLayout>

            </LinearLayout>

            <Button
                    android:id="@+id/btnMeusPremios"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_botao_roxo"
                    android:text="Meus prêmios"
                    android:textColor="@android:color/black" />

            <Button
                    android:id="@+id/btnMeusProblemas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_botao_roxo"
                    android:text="Meus problemas"
                    android:textColor="@android:color/black" />
            <Button
                    android:id="@+id/btnSair"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_botao_vermelho"
                    android:text="Sair"
                    android:textColor="@android:color/black" />

        </LinearLayout>

    </ScrollView>

    <!-- Barra inferior -->
    <include layout="@layout/component_rodape_principal" />

</LinearLayout>